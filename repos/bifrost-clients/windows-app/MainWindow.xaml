<Window x:Class="Bifrost.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Bifrost"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        DataContext="{Binding RelativeSource={RelativeSource Self}, Path=ViewModel}"
        Icon="pack://application:,,,/Bifrost;component/Assets/bifrost.ico"
        Title="Bifrost" Width="1280" Height="810" MinWidth="760" MinHeight="620"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        SizeChanged="Window_SizeChanged" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="{DynamicResource CanvasBrush}" FontFamily="{DynamicResource UiFont}">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="62" ResizeBorderThickness="6" CornerRadius="16" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <local:ManualModeToBooleanConverter x:Key="ManualModeToBooleanConverter" />
    <Style x:Key="StatusLampStyle" TargetType="Ellipse">
      <Setter Property="Fill" Value="{DynamicResource IdleBrush}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Presentation.State}" Value="Preparing"><Setter Property="Fill" Value="{DynamicResource ConnectingBrush}" /></DataTrigger>
        <DataTrigger Binding="{Binding Presentation.State}" Value="Reconnecting"><Setter Property="Fill" Value="{DynamicResource SwitchingBrush}" /></DataTrigger>
        <DataTrigger Binding="{Binding Presentation.State}" Value="Protected"><Setter Property="Fill" Value="{DynamicResource PositiveBrush}" /></DataTrigger>
        <DataTrigger Binding="{Binding Presentation.State}" Value="Blocked"><Setter Property="Fill" Value="{DynamicResource WarningBrush}" /></DataTrigger>
        <DataTrigger Binding="{Binding Presentation.State}" Value="Error"><Setter Property="Fill" Value="{DynamicResource ErrorBrush}" /></DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="RunePanel" TargetType="Border" BasedOn="{StaticResource ProductCard}">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
      <Setter Property="CornerRadius" Value="16" /><Setter Property="Padding" Value="24,24,26,24" />
    </Style>
    <Style x:Key="RuneInset" TargetType="Border" BasedOn="{StaticResource ProductInset}">
      <Setter Property="Background" Value="{DynamicResource InputBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
    </Style>
    <Style x:Key="RuneSectionTitle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter Property="FontSize" Value="{DynamicResource TypeSection}" /><Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="RuneValue" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter Property="FontSize" Value="25" /><Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="RuneCaption" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextGlobal}">
      <Setter Property="LineHeight" Value="20" />
      <Setter Property="Padding" Value="0,2,0,2" />
      <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>
    <Style x:Key="RuneRow" TargetType="Border">
      <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" /><Setter Property="BorderThickness" Value="0,0,0,1" /><Setter Property="Padding" Value="4,11" />
    </Style>
    <Style x:Key="ChromeButton" TargetType="Button" BasedOn="{StaticResource IconButton}"><Setter Property="Width" Value="32" /><Setter Property="Height" Value="32" /><Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" /></Style>
    <Style x:Key="ObsidianNavButton" TargetType="Button">
      <Setter Property="Height" Value="48" /><Setter Property="Margin" Value="0,0,0,7" /><Setter Property="Padding" Value="16,0" />
      <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource BifrostFocusVisual}" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Grid>
          <Border x:Name="NavFrame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center" /></Border>
          <Border x:Name="ActiveRail" Width="3" Height="30" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{DynamicResource AccentBrush}" CornerRadius="0,2,2,0" Visibility="Collapsed" />
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavFrame" Property="Background" Value="#1419CDD3" /><Setter TargetName="NavFrame" Property="BorderBrush" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /></Trigger>
          <Trigger Property="IsDefault" Value="True"><Setter TargetName="NavFrame" Property="Background" Value="#2416C7D0" /><Setter TargetName="NavFrame" Property="BorderBrush" Value="Transparent" /><Setter TargetName="ActiveRail" Property="Visibility" Value="Visible" /><Setter Property="Foreground" Value="#FFFFFF" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="DashboardCaption" TargetType="TextBlock" BasedOn="{StaticResource RuneCaption}">
      <Setter Property="FontSize" Value="{DynamicResource TypeBody}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="DashboardMetric" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei" />
      <Setter Property="FontSize" Value="{DynamicResource DashboardMetricSize}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="Margin" Value="0,10,0,0" />
    </Style>
    <Style x:Key="DashboardLink" TargetType="Button" BasedOn="{StaticResource QuietButton}">
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      <Setter Property="FontSize" Value="{DynamicResource TypeBody}" />
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="ContentTemplate"><Setter.Value><DataTemplate>
        <TextBlock Text="{Binding}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Button}}" />
      </DataTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="DashboardConnectButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
      <Setter Property="MinWidth" Value="200" /><Setter Property="MaxWidth" Value="270" />
      <Setter Property="MinHeight" Value="52" /><Setter Property="Padding" Value="18,12" />
      <Setter Property="Margin" Value="0" /><Setter Property="FontSize" Value="{DynamicResource TypeBody}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Presentation.State}" Value="Protected">
          <Setter Property="Background" Value="#6609121C" />
          <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
          <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    </Window.Resources>

  <Border x:Name="ShellFrame" Background="{DynamicResource ShellBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" CornerRadius="16" ClipToBounds="True">
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="200" /><ColumnDefinition Width="*" /><ColumnDefinition x:Name="InspectorColumn" Width="0" /></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition x:Name="ToolbarRow" Height="62" /><RowDefinition Height="*" /><RowDefinition Height="0" /></Grid.RowDefinitions>

      <Image x:Name="AuroraBackgroundImage" Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0" Grid.RowSpan="2" Stretch="UniformToFill" Opacity="0.68" IsHitTestVisible="False" />
      <Border Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0" Grid.RowSpan="2" IsHitTestVisible="False">
        <Border.Background>
          <RadialGradientBrush Center="0.50,0.25" GradientOrigin="0.50,0.25" RadiusX="0.60" RadiusY="0.60">
            <GradientStop Color="#1A19CDD3" Offset="0" />
            <GradientStop Color="#0019CDD3" Offset="1" />
          </RadialGradientBrush>
        </Border.Background>
      </Border>
      <Border Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0" Grid.RowSpan="2" IsHitTestVisible="False">
        <Border.Background>
          <RadialGradientBrush Center="0.85,0.85" GradientOrigin="0.85,0.85" RadiusX="0.50" RadiusY="0.50">
            <GradientStop Color="#14C084FC" Offset="0" />
            <GradientStop Color="#00C084FC" Offset="1" />
          </RadialGradientBrush>
        </Border.Background>
      </Border>
      <Border Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0" Grid.RowSpan="2" IsHitTestVisible="False">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2E02070C" Offset="0" />
            <GradientStop Color="#9E010508" Offset="1" />
          </LinearGradientBrush>
        </Border.Background>
      </Border>

      <Border x:Name="SidebarBorder" Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,1,0" Panel.ZIndex="200">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FC071521" Offset="0" />
            <GradientStop Color="#FC08121D" Offset="1" />
          </LinearGradientBrush>
        </Border.Background>
        <Grid Margin="14,0,14,0"><Grid.RowDefinitions><RowDefinition Height="174" /><RowDefinition Height="*" /><RowDefinition Height="138" /></Grid.RowDefinitions>
          <StackPanel HorizontalAlignment="Center" Margin="0,28,0,0">
            <Image x:Name="SidebarBrandIcon" Source="pack://application:,,,/Bifrost;component/Assets/bifrost-teal-rune-symbol-v1.png" Width="72" Height="82" Stretch="Uniform" AutomationProperties.Name="Bifrost 斧头标识" />
            <TextBlock Text="BIFROST" Foreground="{DynamicResource AccentBrush}" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,5,0,0" />
          </StackPanel>
          <StackPanel x:Name="NavStack" Grid.Row="1" VerticalAlignment="Top">
            <Button Tag="home" IsDefault="True" Style="{StaticResource ObsidianNavButton}" Command="{Binding NavigateCommand}" CommandParameter="home" AutomationProperties.Name="连接"><StackPanel Orientation="Horizontal"><Path Data="M12,3 V8 M7,8 H17 M7,8 V13 M17,8 V13 M12,8 V18 M5,15 A2,2 0 1 0 9,15 A2,2 0 1 0 5,15 M15,15 A2,2 0 1 0 19,15 A2,2 0 1 0 15,15 M10,19 A2,2 0 1 0 14,19 A2,2 0 1 0 10,19" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" Fill="Transparent" Width="20" Height="20" Stretch="Uniform" /><TextBlock Text="连接" FontSize="{DynamicResource TypeBody}" Margin="14,0,0,0" VerticalAlignment="Center" /></StackPanel></Button>
            <Button Tag="nodes" Style="{StaticResource ObsidianNavButton}" Command="{Binding NavigateCommand}" CommandParameter="nodes" AutomationProperties.Name="线路"><StackPanel Orientation="Horizontal"><Path Data="M12,3 A9,9 0 1 0 12,21 A9,9 0 1 0 12,3 M7,8 A1.4,1.4 0 1 0 7,10.8 A1.4,1.4 0 1 0 7,8 M15.6,6.5 A1.4,1.4 0 1 0 15.6,9.3 A1.4,1.4 0 1 0 15.6,6.5 M16,14 A1.4,1.4 0 1 0 16,16.8 A1.4,1.4 0 1 0 16,14 M7.3,15 A1.4,1.4 0 1 0 7.3,17.8 A1.4,1.4 0 1 0 7.3,15" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" Fill="Transparent" Width="20" Height="20" Stretch="Uniform" /><TextBlock Text="线路" FontSize="{DynamicResource TypeBody}" Margin="14,0,0,0" VerticalAlignment="Center" /></StackPanel></Button>
            <Button Tag="routing" Style="{StaticResource ObsidianNavButton}" Command="{Binding NavigateCommand}" CommandParameter="routing" AutomationProperties.Name="分流"><StackPanel Orientation="Horizontal"><Path Data="M3,7 L9,3 L15,7 L21,4 M3,7 V15 L9,21 L15,16 L21,20 M9,3 V11 M15,7 V16 M3,15 L9,11 L15,16 L21,11 V20" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" Fill="Transparent" Width="20" Height="20" Stretch="Uniform" /><TextBlock Text="分流" FontSize="{DynamicResource TypeBody}" Margin="14,0,0,0" VerticalAlignment="Center" /></StackPanel></Button>
            <Button Tag="activity" Style="{StaticResource ObsidianNavButton}" Command="{Binding NavigateCommand}" CommandParameter="activity" AutomationProperties.Name="活动"><StackPanel Orientation="Horizontal"><Path Data="M12,3 L20,7 V13 C20,17 16.5,20 12,22 C7.5,20 4,17 4,13 V7 Z M7,13 H10 L12,9 L14,16 L16,12 H18" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" Fill="Transparent" Width="20" Height="20" Stretch="Uniform" /><TextBlock Text="活动" FontSize="{DynamicResource TypeBody}" Margin="14,0,0,0" VerticalAlignment="Center" /></StackPanel></Button>
            <Button Tag="settings" Style="{StaticResource ObsidianNavButton}" Command="{Binding NavigateCommand}" CommandParameter="settings" AutomationProperties.Name="设置"><StackPanel Orientation="Horizontal"><Path Data="M12,3 A9,9 0 1 0 12,21 A9,9 0 1 0 12,3 M12,8 A4,4 0 1 0 12,16 A4,4 0 1 0 12,8 M12,1 V4 M12,20 V23 M1,12 H4 M20,12 H23" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" Fill="Transparent" Width="20" Height="20" Stretch="Uniform" /><TextBlock Text="设置" FontSize="{DynamicResource TypeBody}" Margin="14,0,0,0" VerticalAlignment="Center" /></StackPanel></Button>
          </StackPanel>
          <StackPanel Grid.Row="2" Margin="8,0,8,16">
            <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="0,0,16,15" />
            <StackPanel Orientation="Horizontal">
              <Ellipse x:Name="StatusLamp" Width="8" Height="8" Style="{StaticResource StatusLampStyle}" Margin="0,0,10,0" />
              <TextBlock Text="{Binding NetworkProtectionStatus}" Style="{StaticResource DashboardCaption}" />
            </StackPanel>
            <TextBlock Text="{Binding ProductVersion, StringFormat=v{0}}" Style="{StaticResource DashboardCaption}" Margin="0,8,0,2" />
            <Button x:Name="SidebarUpdateButton" Content="{Binding UpdateActionLabel}" Click="SidebarUpdate_Click"
                    Style="{StaticResource DashboardLink}" HorizontalContentAlignment="Left" Padding="0,6"
                    AutomationProperties.Name="检查 Bifrost 更新" ToolTip="打开更新设置并检查程序更新" />
          </StackPanel>
        </Grid>
      </Border>

      <Border x:Name="DesktopTitleBar" Grid.Column="1" Grid.Row="0" Height="62" Background="#5202080E" BorderBrush="#12FFFFFF" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Panel.ZIndex="180">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <TextBlock x:Name="PageTitleText" Text="连接" Foreground="{DynamicResource TextBrush}" FontSize="{DynamicResource TypeTitle}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="30,0,0,0" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
            <TextBlock Text="测试预览 · 示例数据" Style="{StaticResource RuneCaption}" Margin="0,0,20,0"
                       Visibility="{Binding IsTestState, Converter={StaticResource BoolToVisibility}}" />
            <Button x:Name="ThemeQuickButton" Style="{StaticResource ChromeButton}" Command="{Binding NavigateCommand}" CommandParameter="settings" Visibility="Collapsed" Content="⚙" />
            <Button Style="{StaticResource ChromeButton}" Click="MinimizeWindow_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Path Data="M3,12 H15" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Width="14" Height="14" /></Button>
            <Button Style="{StaticResource ChromeButton}" Click="MaximizeWindow_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Rectangle Width="11" Height="11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.1" /></Button>
            <Button Style="{StaticResource ChromeButton}" Click="CloseWindow_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Path Data="M4,4 L16,16 M16,4 L4,16" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Width="14" Height="14" /></Button>
          </StackPanel>
        </Grid>
      </Border>
      <Border x:Name="InspectorBorder" Grid.Column="2" Grid.Row="1" Visibility="Collapsed" />

      <Grid x:Name="CenterWorkspace" Grid.Column="1" Grid.Row="1" Background="Transparent">
        <Button x:Name="SmartGateAdvancedButton" Content="高级设置" Click="SmartGateAdvanced_Click" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,18,30,0" Panel.ZIndex="30" />
        <!-- One connection surface for every viewport. Vertical overflow scrolls. -->
        <ScrollViewer x:Name="HomePage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="30,14,30,24" HorizontalContentAlignment="Stretch">
          <Grid x:Name="HomeContent" MaxWidth="1200" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
              <RowDefinition Height="*" MinHeight="220" /><RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border x:Name="HomeCommandSurface" Style="{StaticResource RunePanel}" Padding="0" ClipToBounds="True">
              <Grid>
                <Border x:Name="HeroAuroraImage" CornerRadius="16" IsHitTestVisible="False">
                  <Border.Background><ImageBrush ImageSource="{Binding Source, ElementName=AuroraBackgroundImage}" Stretch="UniformToFill" Opacity="0.60" /></Border.Background>
                </Border>
                <Border CornerRadius="16" IsHitTestVisible="False">
                  <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#EF0B1A28" Offset="0" /><GradientStop Color="#850B1A28" Offset="1" /></LinearGradientBrush></Border.Background>
                </Border>
                <StackPanel Margin="28,20">
                  <Grid x:Name="HomeHeader">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="HomeActionColumn" Width="Auto" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel x:Name="HomeStatusSummary" Margin="0,0,20,0">
                      <StackPanel Orientation="Horizontal"><Ellipse x:Name="HomeStatusLamp" Width="14" Height="14" Style="{StaticResource StatusLampStyle}" Margin="0,0,14,0" />
                        <TextBlock Text="{Binding DashboardStatusTitle}" Foreground="{DynamicResource TextBrush}" FontSize="{DynamicResource DashboardTitleSize}" FontWeight="SemiBold" />
                      </StackPanel>
                      <TextBlock Text="{Binding DashboardStatusDetail}" Style="{StaticResource DashboardCaption}" Margin="0,7,0,0" />
                    </StackPanel>
                    <Button x:Name="ConnectButton" Grid.Column="1" Style="{StaticResource DashboardConnectButton}"
                            Command="{Binding ConnectCommand}" IsEnabled="{Binding CanUsePrimaryAction}" VerticalAlignment="Top"
                            AutomationProperties.Name="{Binding PrimaryActionLabel}">
                      <StackPanel Orientation="Horizontal">
                        <Path Data="M12,2 V12 M18.4,6.6 A9,9 0 1 1 5.6,6.6" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" Width="19" Height="19" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock Text="{Binding PrimaryActionLabel}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" TextWrapping="Wrap" MaxWidth="200" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                  </Grid>
                  <Grid x:Name="HomeRouteConsole" Margin="0,18,0,14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <WrapPanel VerticalAlignment="Center" Margin="0,0,12,0">
                      <TextBlock Text="{Binding SelectedSourceDisplay}" FontSize="{DynamicResource TypeTitle}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" Margin="0,0,18,0" />
                      <TextBlock Text="{Binding EffectiveCandidateLabel}" FontSize="{DynamicResource TypeTitle}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" Margin="0,0,18,0" />
                      <Border BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" CornerRadius="6" Padding="10,4" VerticalAlignment="Center"><TextBlock Text="{Binding DashboardRouteKind}" Style="{StaticResource RuneCaption}" /></Border>
                    </WrapPanel>
                    <Button Grid.Column="1" Style="{StaticResource DashboardLink}" Content="切换线路  ›" Command="{Binding NavigateCommand}" CommandParameter="nodes" VerticalAlignment="Center" AutomationProperties.Name="切换线路" />
                  </Grid>
                  <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="0,0,0,16" />
                  <Grid x:Name="HomeModeRow">
                    <Grid.ColumnDefinitions><ColumnDefinition x:Name="HomeModeLabelColumn" Width="100" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Text="连接模式" Style="{StaticResource DashboardCaption}" VerticalAlignment="Center" Margin="0,0,0,6" />
                    <ListBox x:Name="ModeBox" Grid.Column="1" Style="{StaticResource SegmentStyle}" MinHeight="44" MaxWidth="520" HorizontalAlignment="Left"
                             SelectedValue="{Binding Mode, Mode=TwoWay}" SelectedValuePath="Tag" IsEnabled="{Binding CanEditConnectionSettings}"
                             ToolTip="{Binding DashboardModeHint}" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="连接模式">
                      <ListBoxItem Tag="smart" AutomationProperties.Name="智能选线"><TextBlock Text="智能选线" FontSize="{DynamicResource TypeBody}" /></ListBoxItem>
                      <ListBoxItem Tag="global" AutomationProperties.Name="全局代理"><TextBlock Text="全局代理" FontSize="{DynamicResource TypeBody}" /></ListBoxItem>
                      <ListBoxItem Tag="smartgate" AutomationProperties.Name="SmartGate"><TextBlock Text="SmartGate" FontSize="{DynamicResource TypeBody}" /></ListBoxItem>
                    </ListBox>
                  </Grid>
              <Border x:Name="HomeSmartGateNodeSelector"

                      Background="{DynamicResource InputBrush}"
                      BorderBrush="{DynamicResource HairlineBrush}"
                      BorderThickness="1"
                      CornerRadius="16"
                      Padding="16,13"
                      Margin="0,16,0,0"
                      Visibility="{Binding IsSmartGateMode, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                  <Grid>
                    <TextBlock Text="SmartGate 节点" FontSize="{DynamicResource TypeBody}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                    <TextBlock Text="{Binding SmartGateNodeAvailabilityText}" HorizontalAlignment="Right" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" />
                  </Grid>
                  <ComboBox x:Name="HomeSmartGateNodeBox"
                            ItemsSource="{Binding CountryOptions}"
                            DisplayMemberPath="Name"
                            SelectedValue="{Binding Country, Mode=TwoWay}"
                            SelectedValuePath="Code"
                            IsEnabled="{Binding CanEditConnectionSettings}"
                            Visibility="{Binding HasCountryOptions, Converter={StaticResource BoolToVisibility}}"
                            MinHeight="44"
                            Margin="0,10,0,0"
                            AutomationProperties.Name="主页选择 SmartGate 节点" />
                  <Border MinHeight="44"
                          Margin="0,10,0,0"
                          Padding="12,0"
                          Background="#12000000"
                          BorderBrush="{DynamicResource HairlineBrush}"
                          BorderThickness="1"
                          CornerRadius="8"
                          Visibility="{Binding NoCountryOptions, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                      <TextBlock Text="暂无可选 SmartGate 节点" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" />
                      <Button Content="刷新节点"
                              Command="{Binding RefreshCommand}"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              MinWidth="78"
                              Height="32"
                              Padding="10,0"
                              AutomationProperties.Name="刷新 SmartGate 节点" />
                    </Grid>
                  </Border>
                  <TextBlock Text="节点由你手动选择；连接期间不会自动换成其他 SmartGate 出口。"
                             Style="{StaticResource RuneCaption}"
                             Margin="0,8,0,0"
                             TextWrapping="Wrap" />
                </StackPanel>
              </Border>


                </StackPanel>
              </Grid>
            </Border>
            <Border Grid.Row="1" x:Name="HomeMetricsCard" Style="{StaticResource RunePanel}" Padding="12,16" Margin="0,16,0,0">
              <UniformGrid x:Name="HomeMetricsGrid" Columns="4">
                <StackPanel Margin="16,2"><TextBlock Text="↓  下载速度" Style="{StaticResource DashboardCaption}" /><TextBlock x:Name="HomeDownloadMetric" Text="{Binding DownloadMetric}" Style="{StaticResource DashboardMetric}" Foreground="{DynamicResource ChartBrush}" ToolTip="{Binding DownloadMetric}" /></StackPanel>
                <StackPanel Margin="16,2"><TextBlock Text="↑  上传速度" Style="{StaticResource DashboardCaption}" /><TextBlock Text="{Binding UploadMetric}" Style="{StaticResource DashboardMetric}" Foreground="{DynamicResource ChartSecondaryBrush}" ToolTip="{Binding UploadMetric}" /></StackPanel>
                <StackPanel Margin="16,2"><TextBlock Text="▥  本次流量" Style="{StaticResource DashboardCaption}" /><TextBlock Text="{Binding SessionMetric}" Style="{StaticResource DashboardMetric}" ToolTip="{Binding SessionMetric}" /></StackPanel>
                <StackPanel Margin="16,2"><TextBlock Text="◷  连接时长" Style="{StaticResource DashboardCaption}" /><TextBlock Text="{Binding DurationMetric}" Style="{StaticResource DashboardMetric}" ToolTip="{Binding DurationMetric}" /></StackPanel>
              </UniformGrid>
            </Border>
            <Border Grid.Row="2" x:Name="HomeActivityCard" Style="{StaticResource RunePanel}" Padding="28,16" Margin="0,16,0,0">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" MinHeight="120" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,20">
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock Text="━  下载" Foreground="{DynamicResource ChartBrush}" Margin="16,0,16,0" /><TextBlock Text="━  上传" Foreground="{DynamicResource ChartSecondaryBrush}" /></StackPanel>
                  <WrapPanel><TextBlock Text="流量趋势" Style="{StaticResource RuneSectionTitle}" Margin="0,0,16,0" /><TextBlock Text="最近 60 次采样" Style="{StaticResource RuneCaption}" /></WrapPanel>
                </DockPanel>
                <Grid Grid.Row="1">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="74" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <Grid><TextBlock x:Name="ChartMaximumLabel" Style="{StaticResource RuneCaption}" VerticalAlignment="Top" /><TextBlock x:Name="ChartMiddleLabel" Style="{StaticResource RuneCaption}" VerticalAlignment="Center" /><TextBlock Text="0" Style="{StaticResource RuneCaption}" VerticalAlignment="Bottom" /></Grid>
                  <Grid x:Name="ChartCanvas" Grid.Column="1" ClipToBounds="True" SizeChanged="TrafficChart_SizeChanged">
                    <Border BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,1,0,1" />
                    <Border Height="1" Background="{DynamicResource HairlineBrush}" Opacity="0.5" VerticalAlignment="Center" />
                    <Polygon x:Name="ChartArea" Fill="#1416C7D0" IsHitTestVisible="False" />
                    <Polyline x:Name="ChartLine" Stroke="{DynamicResource ChartBrush}" StrokeThickness="2.5" IsHitTestVisible="False" />
                    <Polyline x:Name="ChartLineSecondary" Stroke="{DynamicResource ChartSecondaryBrush}" StrokeThickness="1.8" StrokeDashArray="4,3" IsHitTestVisible="False" />
                    <TextBlock Text="{Binding TelemetryAvailabilityText}" Style="{StaticResource DashboardCaption}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20" Visibility="{Binding NoSamples, Converter={StaticResource BoolToVisibility}}" />
                  </Grid>
                </Grid>
                <Grid Grid.Row="2" Margin="74,10,0,0"><TextBlock Text="较早" Style="{StaticResource RuneCaption}" /><TextBlock Text="现在" Style="{StaticResource RuneCaption}" HorizontalAlignment="Right" /></Grid>
              </Grid>
            </Border>
            <Border x:Name="HomeStatusCard" Grid.Row="3" Style="{StaticResource RunePanel}" Padding="18,8" Margin="0,12,0,0">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding DashboardProtectionDetail}" Style="{StaticResource DashboardCaption}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Button Grid.Column="1" Content="查看诊断  ›" Style="{StaticResource DashboardLink}" Command="{Binding NavigateCommand}" CommandParameter="activity" AutomationProperties.Name="查看连接诊断" />
              </Grid>
            </Border>
          </Grid>
        </ScrollViewer>

        <!-- ROUTES -->
        <ScrollViewer x:Name="NodesPage" Visibility="Collapsed" Padding="30,20,30,24" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <Grid x:Name="NodesLayout">
            <Grid.ColumnDefinitions>
              <ColumnDefinition x:Name="NodesFilterColumn" Width="280" />
              <ColumnDefinition x:Name="NodesGapColumn" Width="20" />
              <ColumnDefinition x:Name="NodesCandidatesColumn" Width="*" />
              <ColumnDefinition Width="20" />
              <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition x:Name="NodesRowGap" Height="0" /><RowDefinition Height="0" /></Grid.RowDefinitions>

            <Border x:Name="NodesFilterCard" Grid.Column="0" Style="{StaticResource RunePanel}">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel>
                  <TextBlock Text="真实源站" Style="{StaticResource RuneSectionTitle}" />
                  <TextBlock Text="点击源站查看它包含的全部线路" Style="{StaticResource RuneCaption}" Margin="0,7,0,0" TextWrapping="Wrap" />
                  <Button Content="更新节点" Command="{Binding RefreshCommand}" Margin="0,12,0,0" AutomationProperties.Name="更新节点配置" />
                  <TextBlock Text="{Binding ConfigText}" Style="{StaticResource RuneCaption}" Margin="0,7,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <ComboBox x:Name="SourceBox" Visibility="Collapsed" ItemsSource="{Binding SourceOptions}" DisplayMemberPath="Name" SelectedValue="{Binding Source, Mode=TwoWay}" SelectedValuePath="Code" />
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,14,0,12">
                  <ItemsControl ItemsSource="{Binding SourceRouteGroups}" IsEnabled="{Binding CanEditConnectionSettings}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Command="{Binding DataContext.SelectSourceCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Code}" MinHeight="60" Margin="0,0,0,9" Padding="13,10" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{Binding AutomationName}">
                          <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource QuietButton}">
                              <Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter Property="Background" Value="{DynamicResource SelectedBrush}" /></DataTrigger></Style.Triggers>
                            </Style>
                          </Button.Style>
                          <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel>
                              <TextBlock Text="{Binding Name}" FontSize="{DynamicResource TypeBody}" />
                              <TextBlock Text="{Binding CountText}" Style="{StaticResource RuneCaption}" Margin="0,4,0,0" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="›" FontSize="24" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                          </Grid>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
                <Border x:Name="CountrySelectionCard" Grid.Row="2" Style="{StaticResource RuneRow}" Padding="2,12">
                  <StackPanel>
                    <TextBlock Text="国家 / 地区" Style="{StaticResource RuneCaption}" />
                    <ComboBox x:Name="FrontSourceBox" ItemsSource="{Binding CountryOptions}" DisplayMemberPath="Name" SelectedValue="{Binding Country, Mode=TwoWay}" SelectedValuePath="Code" IsEnabled="{Binding CanEditConnectionSettings}" Visibility="{Binding HasCountryOptions, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="国家选择" />
                    <TextBlock Text="源站直连（没有配置国家出口）" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" FontSize="{DynamicResource TypeBody}" Margin="0,7,0,0" Visibility="{Binding NoCountryOptions, Converter={StaticResource BoolToVisibility}}" />
                  </StackPanel>
                </Border>
                <Border Grid.Row="3" Padding="2,12,2,0">
                  <StackPanel>
                    <TextBlock Text="选择方式" Style="{StaticResource RuneCaption}" />
                    <Grid Margin="0,8,0,0">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                      <RadioButton Content="自动优选" IsChecked="{Binding IsAutoCandidateMode}" IsEnabled="{Binding CanEditConnectionSettings}" />
                      <RadioButton Grid.Column="1" Content="手动选线" IsChecked="{Binding IsManualCandidateMode}" IsEnabled="{Binding CanEditConnectionSettings}" Margin="14,0,0,0" />
                    </Grid>
                  </StackPanel>
                </Border>
                <ComboBox x:Name="CandidateModeBox" Visibility="Collapsed" SelectedValuePath="Tag"><ComboBoxItem Tag="auto">自动</ComboBoxItem><ComboBoxItem Tag="manual">手动</ComboBoxItem></ComboBox>
              </Grid>
            </Border>

            <Border x:Name="NodesCandidatesCard" Grid.Column="2" Style="{StaticResource RunePanel}">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="{Binding CandidateDetailTitle}" Style="{StaticResource RuneSectionTitle}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding CandidateProbeSummaryText}" Style="{StaticResource RuneCaption}" Margin="0,7,0,0" />
                    <ProgressBar Height="5" Margin="0,9,0,0" Minimum="0" Maximum="100" Value="{Binding CandidateProbeProgressPercent, Mode=OneWay}" Foreground="{DynamicResource AccentBrush}" Visibility="{Binding IsCandidateProbeRunning, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="线路测速进度" />
                  </StackPanel>
                  <Button Grid.Column="1" Content="{Binding CandidateProbeActionLabel}" Command="{Binding RefreshCandidateProbesCommand}" IsEnabled="{Binding CanRefreshCandidateProbes}" MinWidth="118" MinHeight="42" Margin="12,0,0,0" AutomationProperties.Name="{Binding CandidateProbeAutomationName}" />
                </Grid>
                <TextBlock Grid.Row="1" Text="点击“选择”固定线路；连接由“连接”页面统一执行，避免同一行出现两套重复操作。" Style="{StaticResource RuneCaption}" Margin="0,12,0,0" TextWrapping="Wrap" />
                <Grid Grid.Row="2" Margin="0,14,0,0">
                    <ListBox x:Name="CandidateRoutesList" ItemsSource="{Binding CandidateRoutes}"
                             Background="Transparent" BorderThickness="0" Padding="0"
                             ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel">
                      <ListBox.Template><ControlTemplate TargetType="ListBox"><Border Background="Transparent"><ScrollViewer x:Name="PART_ScrollViewer" Background="Transparent" Focusable="False" CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter /></ScrollViewer></Border></ControlTemplate></ListBox.Template>
                      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="BorderThickness" Value="0" /><Setter Property="FocusVisualStyle" Value="{x:Null}" /></Style></ListBox.ItemContainerStyle>
                      <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                      <ListBox.ItemTemplate>
                        <DataTemplate>
                          <Border Margin="0,0,0,10" Padding="16,13" CornerRadius="8" BorderThickness="1">
                            <Border.Style>
                              <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
                                <Setter Property="Background" Value="{DynamicResource InputBrush}" />
                                <Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter Property="Background" Value="{DynamicResource SelectedBrush}" /></DataTrigger></Style.Triggers>
                              </Style>
                            </Border.Style>
                            <Grid>
                              <Grid.ColumnDefinitions><ColumnDefinition Width="76" /><ColumnDefinition Width="*" /><ColumnDefinition Width="100" /></Grid.ColumnDefinitions>
                              <Button Content="选择"
                                      Command="{Binding DataContext.SelectCandidateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                      CommandParameter="{Binding Code}"
                                      IsEnabled="{Binding DataContext.CanEditConnectionSettings, RelativeSource={RelativeSource AncestorType=Window}}"
                                      MinHeight="38"
                                      Padding="10,6"
                                      Margin="0,0,12,0"
                                      VerticalAlignment="Center"
                                      AutomationProperties.Name="手动选择此线路" />
                              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="19" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Code}" Style="{StaticResource RuneCaption}" Margin="0,4,0,0" />
                              </StackPanel>
                              <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding LatencyText}" FontSize="19" HorizontalAlignment="Right" />
                                <TextBlock Text="{Binding StatusText}" FontSize="{DynamicResource TypeBody}" HorizontalAlignment="Right" Margin="0,4,0,0">
                                  <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                      <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                                      <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusKind}" Value="available"><Setter Property="Foreground" Value="{DynamicResource PositiveBrush}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding StatusKind}" Value="unavailable"><Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" /></DataTrigger>
                                      </Style.Triggers>
                                    </Style>
                                  </TextBlock.Style>
                                </TextBlock>
                              </StackPanel>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="{Binding CandidateEmptyText}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="2,12" Visibility="{Binding NoCandidateOptions, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
              </Grid>
            </Border>

            <Border x:Name="NodesSummaryCard" Grid.Column="4" Style="{StaticResource RunePanel}">
              <StackPanel>
                <TextBlock Text="当前设置" Style="{StaticResource RuneSectionTitle}" />
                <Border Style="{StaticResource RuneRow}" Margin="0,22,0,0" Padding="5,16"><StackPanel><TextBlock Text="当前线路" Foreground="{DynamicResource AccentBrush}" FontSize="{DynamicResource TypeBody}" /><TextBlock Text="{Binding EffectiveCandidateLabel}" FontSize="22" Margin="0,7,0,0" TextWrapping="Wrap" /></StackPanel></Border>
                <Border Style="{StaticResource RuneRow}" Padding="5,16"><StackPanel><TextBlock Text="真实源站" Foreground="{DynamicResource AccentBrush}" FontSize="{DynamicResource TypeBody}" /><TextBlock Text="{Binding SelectedSourceDisplay}" FontSize="21" Margin="0,7,0,0" TextWrapping="Wrap" /></StackPanel></Border>
                <Border Style="{StaticResource RuneRow}" Padding="5,16"><StackPanel><TextBlock Text="国家出口" Foreground="{DynamicResource AccentBrush}" FontSize="{DynamicResource TypeBody}" /><TextBlock Text="{Binding SelectedCountryDisplay}" FontSize="{DynamicResource TypeBody}" Margin="0,7,0,0" TextWrapping="Wrap" /></StackPanel></Border>
                <Border Padding="5,16"><StackPanel><TextBlock Text="传输" Foreground="{DynamicResource AccentBrush}" FontSize="{DynamicResource TypeBody}" /><TextBlock Text="{Binding TransportSummary}" FontSize="20" Margin="0,7,0,0" /></StackPanel></Border>
              </StackPanel>
            </Border>
          </Grid>
        </ScrollViewer>

        <!-- ROUTING -->
        <Grid x:Name="RoutingPage" Visibility="Collapsed" Margin="26,20,26,24">
          <Grid x:Name="RoutingLayout"><Grid.RowDefinitions><RowDefinition Height="52" /><RowDefinition Height="*" /><RowDefinition x:Name="RoutingRowGap" Height="14" /><RowDefinition Height="260" /></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition x:Name="RoutingModeColumn" Width="1*" /><ColumnDefinition x:Name="RoutingGapColumn" Width="16" /><ColumnDefinition x:Name="RoutingAppsColumn" Width="1*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
            <ListBox x:Name="RoutingModeBox" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Width="470" HorizontalAlignment="Left" Style="{StaticResource SegmentStyle}" SelectedValue="{Binding Mode, Mode=TwoWay}" SelectedValuePath="Tag"><ListBoxItem Tag="smart">智能选线</ListBoxItem><ListBoxItem Tag="global">全局代理</ListBoxItem><ListBoxItem Tag="smartgate">SmartGate</ListBoxItem></ListBox>
            <Border x:Name="RoutingModeCard" Grid.Row="1" Grid.Column="0" Style="{StaticResource RunePanel}"><StackPanel><TextBlock Text="智能选线策略" Style="{StaticResource RuneSectionTitle}" /><Border Style="{StaticResource RuneRow}" Margin="0,12,0,0"><Grid><TextBlock Text="选线范围" FontSize="{DynamicResource TypeBody}" /><TextBlock Text="当前源站内部" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" FontSize="16" /></Grid></Border><Border Style="{StaticResource RuneRow}"><Grid><TextBlock Text="优选依据" FontSize="{DynamicResource TypeBody}" /><TextBlock Text="真实吞吐、延迟与健康度" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" FontSize="16" /></Grid></Border><Border Style="{StaticResource RuneRow}"><Grid><TextBlock Text="候选失败" FontSize="{DynamicResource TypeBody}" /><TextBlock Text="尝试下一条" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" FontSize="16" /></Grid></Border><Border Padding="4,11"><Grid><TextBlock Text="全部失败" FontSize="{DynamicResource TypeBody}" /><TextBlock Text="安全阻断" Foreground="{DynamicResource PositiveBrush}" HorizontalAlignment="Right" FontSize="16" /></Grid></Border><ComboBox x:Name="CoreBox" Visibility="Collapsed" SelectedValue="{Binding Core, Mode=TwoWay}" SelectedValuePath="Tag"><ComboBoxItem Tag="auto">自动（Mihomo）</ComboBoxItem><ComboBoxItem Tag="mihomo">Mihomo</ComboBoxItem></ComboBox></StackPanel></Border>
            <Border x:Name="RoutingAppsCard" Grid.Row="1" Grid.Column="2" Style="{StaticResource RunePanel}"><StackPanel><Grid><TextBlock Text="应用规则" Style="{StaticResource RuneSectionTitle}" /><CheckBox x:Name="AppPolicyEnabledBox" Content="启用应用分流" HorizontalAlignment="Right" IsChecked="{Binding AppPolicyEnabled, Mode=TwoWay}" IsEnabled="{Binding CanEditConnectionSettings}" /></Grid><TextBlock Text="{Binding ApplicationRuleSummary}" Style="{StaticResource RuneCaption}" Margin="0,11,0,0" TextWrapping="Wrap" /><ComboBox x:Name="AppPolicyBox" Margin="0,13,0,0" SelectedValue="{Binding AppPolicy, Mode=TwoWay}" SelectedValuePath="Tag" Visibility="{Binding AppPolicyEnabled, Converter={StaticResource BoolToVisibility}}" IsEnabled="{Binding CanEditConnectionSettings}"><ComboBoxItem Tag="allow">仅名单内应用走代理</ComboBoxItem><ComboBoxItem Tag="exclude">名单内应用直连，其余走代理</ComboBoxItem></ComboBox><Button Content="选择已安装程序…" Click="AddApplication_Click" IsEnabled="{Binding CanEditConnectionSettings}" MinHeight="44" Margin="0,10,0,0" /><StackPanel x:Name="IncludeAppsPanel" Margin="0,12,0,0"><TextBlock Text="代理应用标识（每行一个）" Style="{StaticResource RuneCaption}" /><TextBox x:Name="IncludeAppsBox" Text="{Binding IncludeApps, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=300}" IsEnabled="{Binding CanEditConnectionSettings}" AcceptsReturn="True" MinHeight="92" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" /></StackPanel><StackPanel x:Name="ExcludeAppsPanel" Margin="0,12,0,0"><TextBlock Text="直连应用标识（每行一个）" Style="{StaticResource RuneCaption}" /><TextBox x:Name="ExcludeAppsBox" Text="{Binding ExcludeApps, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=300}" IsEnabled="{Binding CanEditConnectionSettings}" AcceptsReturn="True" MinHeight="92" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" /></StackPanel><TextBlock Text="关闭应用名单时仍使用源站内智能选线；空名单不会参与连接。" Foreground="{DynamicResource MutedTextBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,12,0,0" /></StackPanel></Border>
            <Border Grid.Row="1" Grid.Column="4" Style="{StaticResource RunePanel}"><StackPanel><TextBlock Text="DNS 与保护" Style="{StaticResource RuneSectionTitle}" /><Border Style="{StaticResource RuneRow}" Margin="0,12,0,0"><Grid><TextBlock Text="▢  加密 DNS" FontSize="{DynamicResource TypeBody}" /><TextBlock Text="已启用  ›" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" FontSize="16" /></Grid></Border><Border Style="{StaticResource RuneRow}"><Grid><TextBlock Text="↻  故障切换" FontSize="{DynamicResource TypeBody}" /><TextBlock Text="自动  ›" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" FontSize="16" /></Grid></Border><Border Padding="4,11"><Grid><TextBlock Text="♢  泄漏保护" FontSize="{DynamicResource TypeBody}" /><TextBlock Text="正常  ›" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" FontSize="16" /></Grid></Border></StackPanel></Border>
            <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="5" Style="{StaticResource RunePanel}" Padding="22,14"><StackPanel><TextBlock Text="智能选线执行边界" Style="{StaticResource RuneSectionTitle}" /><Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="1*" /><ColumnDefinition Width="1*" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="当前源站" Style="{StaticResource RuneCaption}" /><TextBlock Text="{Binding SelectedSourceDisplay}" FontSize="20" Margin="0,8,0,0" /></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="候选顺序" Style="{StaticResource RuneCaption}" /><TextBlock Text="按真实测速排序" FontSize="20" Margin="0,8,0,0" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="跨源站" Style="{StaticResource RuneCaption}" /><TextBlock Text="禁止" FontSize="20" Margin="0,8,0,0" /></StackPanel></Grid></StackPanel></Border>
          </Grid>
        </Grid>

        <!-- The production routing workspace presents three genuinely
             different operating modes. The historical RoutingPage above is
             retained as a collapsed automation-compatibility surface only. -->
        <ScrollViewer x:Name="RoutingModeWorkspace" Visibility="Collapsed" Padding="30,20,30,24" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid x:Name="RoutingWorkspaceContent">
          <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <ListBox x:Name="ModeWorkspaceBox"
                   Width="440"
                   HorizontalAlignment="Left"
                   Style="{StaticResource SegmentStyle}"
                   SelectedValue="{Binding Mode, Mode=TwoWay}"
                   SelectedValuePath="Tag"
                   IsEnabled="{Binding CanEditConnectionSettings}"
                   AutomationProperties.Name="代理模式">
            <ListBoxItem Tag="smart" AutomationProperties.Name="源站内智能选线">智能选线</ListBoxItem>
            <ListBoxItem Tag="global" AutomationProperties.Name="全局代理，固定当前线路">全局代理</ListBoxItem>
            <ListBoxItem Tag="smartgate" AutomationProperties.Name="SmartGate">SmartGate</ListBoxItem>
          </ListBox>

          <Grid Grid.Row="1">
            <!-- SMART ROUTING -->
            <Grid x:Name="SmartModePanel" Visibility="{Binding IsSmartMode, Converter={StaticResource BoolToVisibility}}">
              <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="14" /><RowDefinition Height="230" /></Grid.RowDefinitions>
              <Grid.ColumnDefinitions><ColumnDefinition Width="1*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="1*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>

              <Border Grid.Column="0" Style="{StaticResource RunePanel}">
                <StackPanel>
                  <TextBlock Text="源站内智能选线" Style="{StaticResource RuneSectionTitle}" />
                  <TextBlock Text="固定当前源站，只在该源站的签名候选中按真实延迟和健康度自动切换。" Style="{StaticResource RuneCaption}" Margin="0,8,0,8" />
                  <Border Style="{StaticResource RuneRow}"><Grid><TextBlock Text="选线范围" FontSize="{DynamicResource TypeBody}" /><TextBlock Text="当前源站内部" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" /></Grid></Border>
                  <Border Style="{StaticResource RuneRow}"><Grid><TextBlock Text="候选失败" FontSize="{DynamicResource TypeBody}" /><TextBlock Text="尝试下一条" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" /></Grid></Border>
                  <Border Style="{StaticResource RuneRow}"><Grid><TextBlock Text="跨源站" FontSize="{DynamicResource TypeBody}" /><TextBlock Text="禁止" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" /></Grid></Border>
                  <Border Style="{StaticResource RuneRow}"><Grid><TextBlock Text="网络保护" FontSize="{DynamicResource TypeBody}" /><TextBlock Text="已启用" Foreground="{DynamicResource PositiveBrush}" HorizontalAlignment="Right" /></Grid></Border>
                </StackPanel>
              </Border>

              <Border Grid.Column="2" Style="{StaticResource RunePanel}">
                <StackPanel>
                  <Grid>
                    <TextBlock Text="应用规则" Style="{StaticResource RuneSectionTitle}" />
                    <CheckBox x:Name="ModeAppPolicyEnabledBox" Content="启用应用分流" HorizontalAlignment="Right" IsChecked="{Binding AppPolicyEnabled, Mode=TwoWay}" IsEnabled="{Binding CanEditConnectionSettings}" AutomationProperties.Name="启用应用分流" />
                  </Grid>
                  <TextBlock Text="{Binding ApplicationRuleSummary}" Style="{StaticResource RuneCaption}" Margin="0,8,0,0" />
                  <ComboBox x:Name="ModeAppPolicyBox" Margin="0,10,0,0" SelectedValue="{Binding AppPolicy, Mode=TwoWay}" SelectedValuePath="Tag" IsEnabled="{Binding CanEditConnectionSettings}" Visibility="{Binding AppPolicyEnabled, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="应用规则方式">
                    <ComboBoxItem Tag="allow">仅名单内应用走代理</ComboBoxItem>
                    <ComboBoxItem Tag="exclude">名单内应用直连，其余走代理</ComboBoxItem>
                  </ComboBox>
                  <Button Content="选择已安装程序…" Click="AddApplication_Click" IsEnabled="{Binding CanEditConnectionSettings}" MinHeight="44" Margin="0,10,0,0" AutomationProperties.Name="选择已安装程序加入应用规则" />
                  <StackPanel x:Name="ModeIncludeAppsPanel" Margin="0,10,0,0" Visibility="Collapsed">
                    <TextBlock Text="代理程序（可继续手动编辑进程名，每行一个）" Style="{StaticResource RuneCaption}" />
                    <TextBox x:Name="ModeIncludeAppsBox" Text="{Binding IncludeApps, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=300}" IsEnabled="{Binding CanEditConnectionSettings}" AcceptsReturn="True" MinHeight="82" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="代理应用标识" />
                  </StackPanel>
                  <StackPanel x:Name="ModeExcludeAppsPanel" Margin="0,10,0,0" Visibility="Collapsed">
                    <TextBlock Text="直连程序（可继续手动编辑进程名，每行一个）" Style="{StaticResource RuneCaption}" />
                    <TextBox x:Name="ModeExcludeAppsBox" Text="{Binding ExcludeApps, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=300}" IsEnabled="{Binding CanEditConnectionSettings}" AcceptsReturn="True" MinHeight="82" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="直连应用标识" />
                  </StackPanel>
                </StackPanel>
              </Border>

              <Border Grid.Column="4" Style="{StaticResource RunePanel}">
                <StackPanel>
                  <TextBlock Text="DNS 与保护" Style="{StaticResource RuneSectionTitle}" />
                  <Border Style="{StaticResource RuneRow}" Margin="0,10,0,0"><Grid><TextBlock Text="加密 DNS" FontSize="{DynamicResource TypeBody}" /><TextBlock Text="已启用" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" /></Grid></Border>
                  <Border Style="{StaticResource RuneRow}"><Grid><TextBlock Text="故障切换" FontSize="{DynamicResource TypeBody}" /><TextBlock Text="自动" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" /></Grid></Border>
                  <Border Style="{StaticResource RuneRow}"><Grid><TextBlock Text="泄漏保护" FontSize="{DynamicResource TypeBody}" /><TextBlock Text="{Binding NetworkProtectionStatus}" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Right" /></Grid></Border>

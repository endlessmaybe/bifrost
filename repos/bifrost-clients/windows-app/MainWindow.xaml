              <Grid.ColumnDefinitions><ColumnDefinition Width="1*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="1*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
              <Border Grid.Column="0" Style="{StaticResource RunePanel}"><StackPanel><TextBlock Text="全局代理" Style="{StaticResource RuneSectionTitle}" /><TextBlock Text="所有受支持流量通过用户明确选择的当前 A/B 候选；该候选失败时直接报错，不自动换线。" Style="{StaticResource RuneCaption}" Margin="0,8,0,18" /><TextBlock Text="当前源站" Style="{StaticResource RuneCaption}" /><TextBlock Text="{Binding SelectedSourceDisplay}" Style="{StaticResource RuneValue}" Margin="0,8,0,16" /><TextBlock Text="当前线路" Style="{StaticResource RuneCaption}" /><TextBlock Text="{Binding EffectiveCandidateLabel}" FontSize="21" Margin="0,8,0,0" TextWrapping="Wrap" /></StackPanel></Border>
              <Border Grid.Column="2" Style="{StaticResource RunePanel}"><StackPanel><TextBlock Text="代理范围" Style="{StaticResource RuneSectionTitle}" /><Border Style="{StaticResource RuneRow}" Margin="0,10,0,0"><Grid><TextBlock Text="受支持流量" FontSize="{DynamicResource TypeBody}" /><TextBlock Text="全部代理" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" /></Grid></Border><Border Style="{StaticResource RuneRow}"><Grid><TextBlock Text="本机控制通信" FontSize="{DynamicResource TypeBody}" /><TextBlock Text="安全直连" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" /></Grid></Border><Border Style="{StaticResource RuneRow}"><Grid><TextBlock Text="连接失败" FontSize="{DynamicResource TypeBody}" /><TextBlock Text="阻断泄漏" Foreground="{DynamicResource PositiveBrush}" HorizontalAlignment="Right" /></Grid></Border><TextBlock Text="切换到此模式会关闭应用名单，避免显示模式与实际路由不一致。" Style="{StaticResource RuneCaption}" Margin="0,14,0,0" /></StackPanel></Border>
              <Border Grid.Column="4" Style="{StaticResource RunePanel}"><StackPanel><TextBlock Text="链路信息" Style="{StaticResource RuneSectionTitle}" /><TextBlock Text="传输" Style="{StaticResource RuneCaption}" Margin="0,18,0,0" /><TextBlock Text="{Binding TransportSummary}" FontSize="21" Margin="0,7,0,14" /><TextBlock Text="网络保护" Style="{StaticResource RuneCaption}" /><TextBlock Text="{Binding NetworkProtectionStatus}" FontSize="21" Margin="0,7,0,14" /><TextBlock Text="候选线路" Style="{StaticResource RuneCaption}" /><TextBlock Text="{Binding CandidateCountText}" FontSize="{DynamicResource TypeBody}" Margin="0,7,0,0" /></StackPanel></Border>
              <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5" Style="{StaticResource RunePanel}" Padding="22,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="全局代理已选中" Style="{StaticResource RuneSectionTitle}" /><TextBlock Text="下一次建立连接时，服务将使用全局路由并固定当前候选；应用分流名单不会介入。" FontSize="17" Margin="0,12,0,0" TextWrapping="Wrap" /><TextBlock Text="仍保留加密 DNS 和泄漏保护，但不会自动切换候选。" Style="{StaticResource RuneCaption}" Margin="0,8,0,0" /></StackPanel><Button Grid.Column="1" Content="返回连接页" Command="{Binding NavigateCommand}" CommandParameter="home" Width="150" Height="48" VerticalAlignment="Center" AutomationProperties.Name="返回连接页" /></Grid></Border>
            </Grid>

            <!-- SMARTGATE -->
            <Grid x:Name="SmartGateModePanel" Visibility="{Binding IsSmartGateMode, Converter={StaticResource BoolToVisibility}}">
              <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="14" /><RowDefinition Height="230" /></Grid.RowDefinitions>
              <Grid.ColumnDefinitions><ColumnDefinition Width="1*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="1*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
              <Border Grid.Column="0" Style="{StaticResource RunePanel}"><StackPanel><TextBlock Text="SmartGate 状态" Style="{StaticResource RuneSectionTitle}" /><TextBlock Text="{Binding SmartGateManualStatus}" Style="{StaticResource RuneValue}" Margin="0,16,0,0" /><TextBlock Text="SmartGate 节点由用户本人选择，不会自动替换成其他出口节点。" Style="{StaticResource RuneCaption}" Margin="0,10,0,18" /><TextBlock Text="当前节点" Style="{StaticResource RuneCaption}" /><TextBlock Text="{Binding SmartGateNodeSummary}" FontSize="21" Margin="0,7,0,0" TextWrapping="Wrap" /></StackPanel></Border>
              <Border Grid.Column="2" Style="{StaticResource RunePanel}"><StackPanel><TextBlock Text="节点选择" Style="{StaticResource RuneSectionTitle}" /><TextBlock Text="请选择管理员已经发布的 SmartGate 节点" Style="{StaticResource RuneCaption}" Margin="0,10,0,10" /><ComboBox x:Name="SmartGateNodeBox" ItemsSource="{Binding CountryOptions}" DisplayMemberPath="Name" SelectedValue="{Binding Country, Mode=TwoWay}" SelectedValuePath="Code" IsEnabled="{Binding CanEditConnectionSettings}" Visibility="{Binding HasCountryOptions, Converter={StaticResource BoolToVisibility}}" MinHeight="44" AutomationProperties.Name="选择 SmartGate 节点" /><TextBlock Text="当前没有可用 SmartGate 节点，请等待管理员发布。" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Visibility="{Binding NoCountryOptions, Converter={StaticResource BoolToVisibility}}" Margin="0,6,0,0" /><Border Style="{StaticResource RuneRow}" Margin="0,12,0,0"><Grid><TextBlock Text="选择方式" FontSize="{DynamicResource TypeBody}" /><TextBlock Text="用户手动" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" /></Grid></Border><Border Style="{StaticResource RuneRow}"><Grid><TextBlock Text="故障策略" FontSize="{DynamicResource TypeBody}" /><TextBlock Text="{Binding SmartGateManualFailoverStatus}" Foreground="{DynamicResource PositiveBrush}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="220" /></Grid></Border></StackPanel></Border>
              <Border Grid.Column="4" Style="{StaticResource RunePanel}"><StackPanel><TextBlock Text="接入与保护" Style="{StaticResource RuneSectionTitle}" /><TextBlock Text="接入源站" Style="{StaticResource RuneCaption}" Margin="0,18,0,0" /><TextBlock Text="{Binding SelectedSourceDisplay}" FontSize="21" Margin="0,7,0,14" TextWrapping="Wrap" /><TextBlock Text="传输" Style="{StaticResource RuneCaption}" /><TextBlock Text="{Binding TransportSummary}" FontSize="21" Margin="0,7,0,14" /><TextBlock Text="保护状态" Style="{StaticResource RuneCaption}" /><TextBlock Text="{Binding NetworkProtectionStatus}" FontSize="21" Margin="0,7,0,0" /></StackPanel></Border>
              <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5" Style="{StaticResource RunePanel}" Padding="22,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="240" /></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="SmartGate 控制台" Style="{StaticResource RuneSectionTitle}" /><TextBlock Text="先由用户明确选择 SmartGate 节点，再建立连接。系统只维护所选节点的接入链路，不会在后台擅自切换到其他 SmartGate 节点。" FontSize="17" Margin="0,12,0,0" TextWrapping="Wrap" /><Button Content="线路与源站设置" Click="OpenSmartGateAdvanced_Click" Width="160" Height="42" HorizontalAlignment="Left" Margin="0,14,0,0" AutomationProperties.Name="SmartGate 线路与源站设置" /></StackPanel><Button x:Name="SmartGateConnectButton" Grid.Column="2" Content="{Binding SmartGateManualActionLabel}" Command="{Binding ConnectCommand}" IsEnabled="{Binding CanUseSmartGateAction}" Height="54" VerticalAlignment="Center" AutomationProperties.Name="连接所选 SmartGate 节点" /></Grid></Border>
            </Grid>
          </Grid>
        </Grid></ScrollViewer>

        <!-- ACTIVITY -->
        <ScrollViewer x:Name="ActivityPage" Visibility="Collapsed" Padding="30,20,30,24" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid x:Name="ActivityContent"><Grid.RowDefinitions><RowDefinition Height="108" /><RowDefinition Height="18" /><RowDefinition Height="*" /><RowDefinition Height="18" /><RowDefinition Height="220" /></Grid.RowDefinitions>
          <Grid x:Name="ActivityMetricsGrid"><Grid.ColumnDefinitions><ColumnDefinition Width="1*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="1*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="1*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition x:Name="ActivityMetricRowGap" Height="0" /></Grid.RowDefinitions><Border x:Name="ActivityDownloadMetric" Grid.Column="0" Style="{StaticResource RunePanel}" Padding="18"><StackPanel><TextBlock Text="下载速率" Style="{StaticResource RuneCaption}" /><TextBlock Text="{Binding DownloadMetric}" FontSize="22" Margin="0,10,0,0" TextWrapping="Wrap" /></StackPanel></Border><Border x:Name="ActivityUploadMetric" Grid.Column="2" Style="{StaticResource RunePanel}" Padding="18"><StackPanel><TextBlock Text="上传速率" Style="{StaticResource RuneCaption}" /><TextBlock Text="{Binding UploadMetric}" FontSize="22" Margin="0,10,0,0" TextWrapping="Wrap" /></StackPanel></Border><Border x:Name="ActivitySessionMetric" Grid.Column="4" Style="{StaticResource RunePanel}" Padding="18"><StackPanel><TextBlock Text="本次流量" Style="{StaticResource RuneCaption}" /><TextBlock Text="{Binding SessionMetric}" FontSize="22" Margin="0,10,0,0" TextWrapping="Wrap" /></StackPanel></Border><Border x:Name="ActivityDurationMetric" Grid.Column="6" Style="{StaticResource RunePanel}" Padding="18"><StackPanel><TextBlock Text="连接时长" Style="{StaticResource RuneCaption}" /><TextBlock Text="{Binding DurationMetric}" FontSize="22" Margin="0,10,0,0" TextWrapping="Wrap" /></StackPanel></Border><TextBlock x:Name="ActivityEmptyText" Text="{Binding TelemetryAvailabilityText}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" /></Grid>
          <Border Grid.Row="2" Style="{StaticResource RunePanel}" Padding="22,18"><Grid><Grid.RowDefinitions><RowDefinition Height="38" /><RowDefinition Height="*" /></Grid.RowDefinitions><StackPanel><TextBlock Text="实时活动" FontSize="21" /><TextBlock Text="{Binding LiveStatusText}" Style="{StaticResource RuneCaption}" Margin="0,4,0,0" /></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock Text="━  下载" Foreground="{DynamicResource ChartBrush}" Margin="0,0,24,0" /><TextBlock Text="━  上传" Foreground="{DynamicResource ChartSecondaryBrush}" /></StackPanel><Canvas x:Name="ActivityChartCanvas" SizeChanged="TrafficChart_SizeChanged" Grid.Row="1" Margin="20,10,0,0" ClipToBounds="True"><Line X1="0" Y1="35" X2="1100" Y2="35" Stroke="{DynamicResource HairlineBrush}" StrokeDashArray="3,3" /><Line X1="0" Y1="95" X2="1100" Y2="95" Stroke="{DynamicResource HairlineBrush}" StrokeDashArray="3,3" /><Line X1="0" Y1="155" X2="1100" Y2="155" Stroke="{DynamicResource HairlineBrush}" StrokeDashArray="3,3" /><Polyline x:Name="ActivityChartLine" Stroke="{DynamicResource ChartBrush}" StrokeThickness="2" /><Polyline x:Name="ActivityChartLineSecondary" Stroke="{DynamicResource ChartSecondaryBrush}" StrokeThickness="2" /></Canvas><TextBlock Grid.Row="1" Text="{Binding TelemetryAvailabilityText}" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Visibility="{Binding NoSamples, Converter={StaticResource BoolToVisibility}}" /></Grid></Border>
          <Border Grid.Row="4" Style="{StaticResource RunePanel}" Padding="22,14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><TextBlock Text="实时状态记录" FontSize="21" /><Grid Grid.Row="1" Margin="0,12,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="0.7*" /><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="1.6*" /><ColumnDefinition Width="1.6*" /></Grid.ColumnDefinitions><TextBlock Text="时间" Style="{StaticResource RuneCaption}" /><TextBlock Grid.Column="1" Text="事件" Style="{StaticResource RuneCaption}" /><TextBlock Grid.Column="2" Text="源站 / 线路" Style="{StaticResource RuneCaption}" /><TextBlock Grid.Column="3" Text="状态" Style="{StaticResource RuneCaption}" /></Grid><ItemsControl Grid.Row="2" ItemsSource="{Binding LiveEvents}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource RuneRow}" Padding="0,7"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="0.7*" /><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="1.6*" /><ColumnDefinition Width="1.6*" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Time}" /><TextBlock Grid.Column="1" Text="{Binding Event}" /><TextBlock Grid.Column="2" Text="{Binding Route}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Route}" /><TextBlock Grid.Column="3" Text="{Binding Status}" Foreground="{DynamicResource PositiveBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Grid></Border>
        </Grid></ScrollViewer>

        <!-- SETTINGS -->
        <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="36,26,36,26"><Grid x:Name="SettingsLayout"><Grid.ColumnDefinitions><ColumnDefinition x:Name="SettingsLeftColumn" Width="1*" /><ColumnDefinition x:Name="SettingsGapColumn" Width="20" /><ColumnDefinition x:Name="SettingsRightColumn" Width="1*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition x:Name="SettingsTopRow" Height="310" /><RowDefinition x:Name="SettingsRowGap" Height="20" /><RowDefinition x:Name="SettingsBottomRow" Height="Auto" /><RowDefinition x:Name="SettingsNarrowGapOne" Height="0" /><RowDefinition x:Name="SettingsNarrowThirdRow" Height="0" /><RowDefinition x:Name="SettingsNarrowGapTwo" Height="0" /><RowDefinition x:Name="SettingsNarrowFourthRow" Height="0" /></Grid.RowDefinitions>
          <Border x:Name="SettingsGeneralCard" Grid.Column="0" Grid.Row="0" Style="{StaticResource RunePanel}"><StackPanel><TextBlock Text="⚙  常规" Style="{StaticResource RuneValue}" FontSize="22" /><Border Style="{StaticResource RuneRow}" Margin="0,16,0,0"><Grid><TextBlock Text="◯  开机启动" FontSize="{DynamicResource TypeBody}" /><CheckBox x:Name="StartupCheckBox" HorizontalAlignment="Right" Checked="StartupCheckBox_Changed" Unchecked="StartupCheckBox_Changed" AutomationProperties.Name="开机启动 Bifrost" /></Grid></Border><Border Style="{StaticResource RuneRow}"><Grid><TextBlock Text="⇩  关闭时最小化到托盘" FontSize="{DynamicResource TypeBody}" /><CheckBox x:Name="MinimizeToTrayCheckBox" HorizontalAlignment="Right" Checked="MinimizeToTrayCheckBox_Changed" Unchecked="MinimizeToTrayCheckBox_Changed" AutomationProperties.Name="关闭时最小化到托盘" /></Grid></Border><Border Style="{StaticResource RuneRow}"><Grid><TextBlock Text="♧  显示通知" FontSize="{DynamicResource TypeBody}" /><CheckBox x:Name="NotificationsCheckBox" HorizontalAlignment="Right" Checked="NotificationsCheckBox_Changed" Unchecked="NotificationsCheckBox_Changed" AutomationProperties.Name="显示系统通知" /></Grid></Border></StackPanel></Border>
          <Border x:Name="SettingsAppearanceCard" Grid.Column="2" Grid.Row="0" Style="{StaticResource RunePanel}"><StackPanel><TextBlock Text="♢  外观" Style="{StaticResource RuneValue}" FontSize="22" /><Border Style="{StaticResource RuneRow}" Margin="0,16,0,0"><Grid><TextBlock Text="☾  深色极光" FontSize="{DynamicResource TypeBody}" /><TextBlock Text="已启用" Foreground="{DynamicResource AccentBrush}" FontSize="17" HorizontalAlignment="Right" /></Grid></Border><Border Style="{StaticResource RuneRow}"><Grid><TextBlock Text="Aa  界面字体" FontSize="{DynamicResource TypeBody}" /><TextBlock Text="Microsoft YaHei" Foreground="{DynamicResource AccentBrush}" FontSize="17" HorizontalAlignment="Right" /></Grid></Border><Border Style="{StaticResource RuneRow}"><StackPanel><Grid><TextBlock Text="界面缩放" FontSize="{DynamicResource TypeBody}" /><TextBlock x:Name="UiScaleValueText" Text="100%" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" /></Grid><Slider x:Name="UiScaleSlider" Minimum="80" Maximum="140" Value="100" Margin="0,14,0,6" IsSnapToTickEnabled="True" TickFrequency="5" ValueChanged="UiScaleSlider_ValueChanged" AutomationProperties.Name="界面缩放" /></StackPanel></Border><ComboBox x:Name="ThemeBox" Visibility="Collapsed" SelectedValue="{Binding Theme, Mode=TwoWay}" SelectedValuePath="Tag"><ComboBoxItem Tag="dark">深色</ComboBoxItem></ComboBox><ListBox x:Name="DesignDirectionBox" Visibility="Collapsed" /><Border x:Name="PreviewRail" Visibility="Collapsed" /><Border x:Name="PreviewHero" Visibility="Collapsed" /><StackPanel x:Name="PreviewStack" Visibility="Collapsed" /></StackPanel></Border>
          <Border x:Name="SettingsAccountCard" Grid.Column="0" Grid.Row="2" Style="{StaticResource RunePanel}">
            <StackPanel>
              <TextBlock Text="♙  设备与账户" Style="{StaticResource RuneValue}" FontSize="22" />
              <Border Style="{StaticResource RuneRow}" Margin="0,16,0,0"><Grid><TextBlock Text="▱  设备状态" FontSize="{DynamicResource TypeBody}" /><TextBlock Text="{Binding DeviceRegistrationStatus}" Foreground="{DynamicResource AccentBrush}" FontSize="17" HorizontalAlignment="Right" /></Grid></Border>
              <Border Style="{StaticResource RuneRow}"><Grid><TextBlock Text="◉  控制端" FontSize="{DynamicResource TypeBody}" /><TextBlock x:Name="ControlOriginStatusText" Text="{Binding ControlOriginStatus}" Foreground="{DynamicResource AccentBrush}" FontSize="17" HorizontalAlignment="Right" /></Grid></Border>
              <Grid x:Name="ActivationRecoveryLayout" Margin="0,14,0,0" Visibility="{Binding RequiresActivation, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="邀请码或账号恢复码" Style="{StaticResource RuneCaption}" />
                  <PasswordBox x:Name="InviteBox" Margin="0,7,0,0" MinHeight="38" IsEnabled="{Binding CanStartEnrollment}" AutomationProperties.Name="邀请码或账号恢复码" />
                  <TextBox x:Name="TestInviteBox" Visibility="Collapsed" AutomationProperties.Name="TEST-ONLY 邀请码" />
                  <Button x:Name="EnrollButton" Content="激活设备" Margin="0,10,0,0" MinHeight="40" IsEnabled="{Binding CanStartEnrollment}" Click="Enroll_Click" AutomationProperties.Name="激活设备" />
                </StackPanel>
                <Border Grid.Column="2" Padding="10,8" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" CornerRadius="7">
                  <StackPanel>
                    <TextBlock Text="从 Android 激活此电脑" Style="{StaticResource RuneCaption}" />
                    <TextBlock Text="粘贴另一端设置中的账号恢复码，无需再次输入账号编号。" Margin="0,7,0,0" Style="{StaticResource RuneCaption}" TextWrapping="Wrap" />
                    <TextBox x:Name="RecoveryPublicIdBox" Visibility="Collapsed" IsEnabled="False" />
                    <PasswordBox x:Name="RecoveryCodeBox" Margin="0,7,0,0" MinHeight="38" IsEnabled="{Binding CanStartEnrollment}" AutomationProperties.Name="账号恢复码" />
                    <Button x:Name="RecoverButton" Content="使用恢复码激活" Margin="0,10,0,0" MinHeight="40" IsEnabled="{Binding CanStartEnrollment}" Click="Recover_Click" AutomationProperties.Name="使用恢复码激活" />
                  </StackPanel>
                </Border>
              </Grid>
              <TextBlock Text="{Binding UpdateText}" Margin="0,8,0,0" Style="{StaticResource RuneCaption}" TextWrapping="Wrap" Visibility="{Binding RequiresActivation, Converter={StaticResource BoolToVisibility}}" />
              <Border x:Name="SavedRecoveryCodePanel" Margin="0,18,0,0" Padding="10,8" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" CornerRadius="7" Visibility="{Binding IsEnrolled, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                  <TextBlock Text="账号恢复码（换设备时使用）" Style="{StaticResource RuneCaption}" />
                  <TextBox x:Name="SavedRecoveryCodeBox" Text="{Binding RecoveryCode, Mode=OneWay}" Margin="0,7,0,0" MinHeight="38" IsReadOnly="True" TextWrapping="Wrap" AutomationProperties.Name="当前账号完整恢复码" />
                  <TextBlock Text="{Binding RecoveryCodeStatus}" Style="{StaticResource RuneCaption}" Margin="0,6,0,0" TextWrapping="Wrap" />
                  <Button x:Name="RotateRecoveryCodeButton" Content="重新生成恢复码" Margin="0,10,0,0" MinHeight="40" IsEnabled="{Binding CanInteract}" Click="RotateRecoveryCode_Click" AutomationProperties.Name="重新生成账号恢复码" />
                </StackPanel>
              </Border>
              <Grid Margin="0,18,0,0" Visibility="{Binding IsEnrolled, Converter={StaticResource BoolToVisibility}}"><Grid.ColumnDefinitions><ColumnDefinition Width="1*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions><Button x:Name="CreatePairingButton" Content="🔗  设备配对" Click="CreatePairing_Click" /><Button x:Name="LogoutButton" Grid.Column="2" Content="↪  注销设备" Command="{Binding LogoutCommand}" /></Grid><PasswordBox x:Name="PairingCodeInput" Visibility="Collapsed" /><Button x:Name="RedeemPairingButton" Visibility="Collapsed" Click="RedeemPairing_Click" />
            </StackPanel>
          </Border>
          <Border x:Name="SettingsUpdateCard" Grid.Column="2" Grid.Row="2" Style="{StaticResource RunePanel}">
            <StackPanel>
              <TextBlock Text="ⓘ  更新与关于" Style="{StaticResource RuneValue}" FontSize="22" />
              <Border Style="{StaticResource RuneRow}" Margin="0,16,0,0"><Grid><TextBlock Text="♢  Bifrost" FontSize="{DynamicResource TypeBody}" /><TextBlock Text="{Binding ProductVersion}" Foreground="{DynamicResource AccentBrush}" FontSize="17" HorizontalAlignment="Right" /></Grid></Border>
              <Border Style="{StaticResource RuneRow}"><Grid><TextBlock Text="↻  自动更新" FontSize="{DynamicResource TypeBody}" /><TextBlock Text="{Binding UpdateAvailabilityText}" Foreground="{DynamicResource AccentBrush}" FontSize="17" HorizontalAlignment="Right" /></Grid></Border>
              <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
                <Button x:Name="CheckUpdateButton" Content="{Binding UpdateActionLabel}" Command="{Binding CheckUpdateCommand}" AutomationProperties.Name="检查 Bifrost 更新" />
                <Button Grid.Column="2" Content="〈/〉  开源许可证" Click="LicensePaged_Click" />
              </Grid>
              <Border Margin="0,12,0,0" Padding="12,9" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" CornerRadius="7">
                <Grid>
                  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding UpdateStatusTitle}" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding UpdateStatusKind}" Value="current"><Setter Property="Foreground" Value="{DynamicResource PositiveBrush}" /></DataTrigger>
                            <DataTrigger Binding="{Binding UpdateStatusKind}" Value="success"><Setter Property="Foreground" Value="{DynamicResource PositiveBrush}" /></DataTrigger>
                            <DataTrigger Binding="{Binding UpdateStatusKind}" Value="warning"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}" /></DataTrigger>
                            <DataTrigger Binding="{Binding UpdateStatusKind}" Value="failed"><Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" /></DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Grid.Column="1" Text="{Binding UpdateProgressText}" Foreground="{DynamicResource MutedTextBrush}" Margin="12,0,0,0" />
                  </Grid>
                  <ProgressBar Grid.Row="1" Height="5" Margin="0,8,0,0" Minimum="0" Maximum="100" Value="{Binding UpdateProgress, Mode=OneWay}" IsIndeterminate="{Binding UpdateProgressIndeterminate, Mode=OneWay}" Foreground="{DynamicResource AccentBrush}" AutomationProperties.Name="程序更新进度" />
                  <TextBlock x:Name="UpdateStatusMessageText" Grid.Row="2" Text="{Binding UpdateStatusMessage}" Style="{StaticResource RuneCaption}" Margin="0,7,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                </Grid>
              </Border>
              <Button x:Name="RefreshButton" Content="更新节点" Margin="0,16,0,0" Command="{Binding RefreshCommand}" AutomationProperties.Name="更新节点，无需安装软件" />
              <TextBlock x:Name="ConfigText" Text="{Binding ConfigText}" Style="{StaticResource RuneCaption}" Margin="0,8,0,0" />
              <TextBlock Text="节点在线自动同步；软件升级单独检查。" Style="{StaticResource RuneCaption}" Margin="0,4,0,0" />
            </StackPanel>
          </Border>
        </Grid></ScrollViewer>
      </Grid>

      <Border Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="2" Visibility="Collapsed"><Grid><Grid.ColumnDefinitions><ColumnDefinition x:Name="FooterSidebarColumn" Width="144" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions></Grid></Border>
    </Grid>
  </Border>
</Window>

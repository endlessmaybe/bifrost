<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <!-- Bifrost obsidian-console design tokens. -->

  <!-- Type -->
  <!-- Match the approved showcase: Microsoft YaHei is the primary Chinese UI
       face, with Segoe UI as the Windows fallback and Cascadia Code for the
       compact status/technical labels. -->
  <FontFamily x:Key="UiFont">Microsoft YaHei, 微软雅黑, Segoe UI Variable Text, Segoe UI, sans-serif</FontFamily>
  <FontFamily x:Key="BrandFont">Microsoft YaHei, 微软雅黑, Segoe UI Variable Text, Segoe UI, sans-serif</FontFamily>
  <FontFamily x:Key="MonoFont">Cascadia Code, Consolas</FontFamily>
  <sys:Double x:Key="TypeDisplay">28</sys:Double>
  <sys:Double x:Key="TypeTitle">22</sys:Double>
  <sys:Double x:Key="TypeSection">16</sys:Double>
  <sys:Double x:Key="TypeBody">14</sys:Double>
  <sys:Double x:Key="TypeCaption">12</sys:Double>
  <sys:Double x:Key="TypeMicro">11</sys:Double>
  <sys:Double x:Key="TypeMetric">18</sys:Double>

  <sys:Double x:Key="DashboardMetricSize">29</sys:Double>
  <sys:Double x:Key="DashboardTitleSize">30</sys:Double>

  <!-- 4pt spacing rhythm -->
  <sys:Double x:Key="Space1">4</sys:Double>
  <sys:Double x:Key="Space2">8</sys:Double>
  <sys:Double x:Key="Space3">12</sys:Double>
  <sys:Double x:Key="Space4">16</sys:Double>
  <sys:Double x:Key="Space5">20</sys:Double>
  <sys:Double x:Key="Space6">24</sys:Double>
  <sys:Double x:Key="Space8">32</sys:Double>
  <sys:Double x:Key="Space10">40</sys:Double>

  <!-- Warm, carved frames: compact radii with enough softness for the
       reference's inset black-gold cards and selected navigation capsule. -->
  <CornerRadius x:Key="RadiusXs">3</CornerRadius>
  <CornerRadius x:Key="RadiusSm">6</CornerRadius>
  <CornerRadius x:Key="RadiusMd">8</CornerRadius>
  <CornerRadius x:Key="RadiusLg">10</CornerRadius>
  <CornerRadius x:Key="RadiusXl">12</CornerRadius>
  <CornerRadius x:Key="CardRadius">16</CornerRadius>
  <CornerRadius x:Key="ControlRadius">7</CornerRadius>
  <CornerRadius x:Key="PillRadius">999</CornerRadius>
  <Thickness x:Key="FocusThickness">2</Thickness>
  <Thickness x:Key="PagePadding">22,18,22,18</Thickness>
  <Thickness x:Key="CardPadding">16</Thickness>
  <Thickness x:Key="CompactCardPadding">14</Thickness>
  <Thickness x:Key="ControlPadding">12,7</Thickness>
  <Thickness x:Key="DenseControlPadding">9,5</Thickness>

  <!-- Interaction sizes. -->
  <sys:Double x:Key="ControlHeight">40</sys:Double>
  <sys:Double x:Key="TouchTarget">44</sys:Double>
  <sys:Double x:Key="NavItemHeight">50</sys:Double>
  <sys:Double x:Key="CompactNavHeight">56</sys:Double>

  <!-- Product direction defaults (A / Precision). -->
  <sys:Double x:Key="SidebarWidth">200</sys:Double>
  <sys:Double x:Key="CompactSidebarWidth">148</sys:Double>
  <sys:Double x:Key="HeroDialSize">272</sys:Double>
  <sys:Double x:Key="ModeControlWidth">360</sys:Double>
  <sys:Double x:Key="PanelGap">16</sys:Double>
  <sys:Double x:Key="ShellInset">0</sys:Double>
  <sys:Double x:Key="BrandArtworkOpacity">0.56</sys:Double>
  <sys:Double x:Key="HomePrimaryRatio">1.58</sys:Double>
  <sys:Double x:Key="HomeSecondaryRatio">1.0</sys:Double>

  <!-- Motion remains short and interruptible. -->
  <Duration x:Key="MotionFast">0:0:0.12</Duration>
  <Duration x:Key="MotionStandard">0:0:0.18</Duration>
  <Duration x:Key="MotionEmphasis">0:0:0.25</Duration>

  <!-- Low, dense elevation keeps the console carved into the background. -->
  <DropShadowEffect x:Key="Elevation1" BlurRadius="12" ShadowDepth="2" Opacity="0.28" Color="#000000" />
  <DropShadowEffect x:Key="Elevation2" BlurRadius="20" ShadowDepth="5" Opacity="0.38" Color="#000000" />

  <!-- Focus visual shared by keyboard-operable controls. -->
  <Style x:Key="BifrostFocusVisual">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Border Margin="-3" BorderBrush="{DynamicResource FocusBrush}" BorderThickness="2" CornerRadius="{DynamicResource ControlRadius}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>

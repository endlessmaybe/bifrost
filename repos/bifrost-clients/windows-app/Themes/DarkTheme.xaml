<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <sys:Double x:Key="ShellShadowBlur">28</sys:Double>
  <sys:Double x:Key="ShellShadowDepth">8</sys:Double>
  <sys:Double x:Key="ShellShadowOpacity">0.58</sys:Double>

  <!-- Unified dark aurora material. Dense data surfaces preserve text contrast. -->
  <SolidColorBrush x:Key="CanvasBrush" Color="#09121C" />
  <LinearGradientBrush x:Key="ShellBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#050B0F" Offset="0" />
    <GradientStop Color="#03080B" Offset="0.56" />
    <GradientStop Color="#09121C" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="ToolbarBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#080F13" Offset="0" />
    <GradientStop Color="#03080B" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="SidebarBrush" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#071015" Offset="0" />
    <GradientStop Color="#02070A" Offset="1" />
  </LinearGradientBrush>
  <RadialGradientBrush x:Key="WorkspaceBrush" Center="0.46,0.36" GradientOrigin="0.42,0.24" RadiusX="0.95" RadiusY="0.95">
    <GradientStop Color="#0B1E24" Offset="0" />
    <GradientStop Color="#051015" Offset="0.64" />
    <GradientStop Color="#09121C" Offset="1" />
  </RadialGradientBrush>
  <LinearGradientBrush x:Key="InspectorBrush" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#071319" Offset="0" />
    <GradientStop Color="#03090C" Offset="1" />
  </LinearGradientBrush>

  <!-- Dense stone/metal panel stack. -->
  <SolidColorBrush x:Key="SurfaceBrush" Color="#F20D1D2B" />
  <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="#142735" />
  <SolidColorBrush x:Key="InputBrush" Color="#0A1824" />

  <SolidColorBrush x:Key="TextBrush" Color="#F5F8FA" />
  <SolidColorBrush x:Key="MutedTextBrush" Color="#A1B4C0" />
  <SolidColorBrush x:Key="SubtleTextBrush" Color="#8DA2B3" />

  <SolidColorBrush x:Key="InspectorDividerBrush" Color="#203D42" />
  <SolidColorBrush x:Key="HairlineBrush" Color="#2C4355" />
  <SolidColorBrush x:Key="StrokeBrush" Color="#536A7C" />
  <SolidColorBrush x:Key="FocusBrush" Color="#16C7D0" />
  <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#1A12262B" />
  <SolidColorBrush x:Key="SurfacePressedBrush" Color="#0D1A1F" />
  <SolidColorBrush x:Key="ScrimBrush" Color="#B3000000" />
  <SolidColorBrush x:Key="SelectedBrush" Color="#42112D34" />
  <SolidColorBrush x:Key="ToolbarSegmentBrush" Color="#071015" />
  <SolidColorBrush x:Key="ToolbarSegmentSelectedBrush" Color="#173139" />
  <SolidColorBrush x:Key="ModeSelectedBrush" Color="#173139" />
  <SolidColorBrush x:Key="InspectorCardBrush" Color="#071318" />

  <!-- Luminous cyan is the rune and interaction signal. -->
  <SolidColorBrush x:Key="AccentBrush" Color="#16C7D0" />
  <SolidColorBrush x:Key="AccentSoftBrush" Color="#3D357D82" />
  <SolidColorBrush x:Key="PrimaryActionTextBrush" Color="#031013" />
  <SolidColorBrush x:Key="PositiveBrush" Color="#30D158" />
  <SolidColorBrush x:Key="WarningBrush" Color="#D69D51" />
  <SolidColorBrush x:Key="ErrorBrush" Color="#D9685C" />
  <SolidColorBrush x:Key="InfoBrush" Color="#23BBD0" />
  <SolidColorBrush x:Key="ConnectingBrush" Color="#23BBD0" />
  <SolidColorBrush x:Key="SwitchingBrush" Color="#9A6AD1" />
  <SolidColorBrush x:Key="IdleBrush" Color="#777268" />
  <SolidColorBrush x:Key="ChartBrush" Color="#42D7E1" />
  <SolidColorBrush x:Key="ChartSecondaryBrush" Color="#91ACF2" />

  <SolidColorBrush x:Key="LogoBrush" Color="#20D7DD" />
  <SolidColorBrush x:Key="DialBrush" Color="#0A0B08" />
  <SolidColorBrush x:Key="DialInnerBrush" Color="#11120E" />
  <SolidColorBrush x:Key="DialHighlightBrush" Color="#695C43" />
  <SolidColorBrush x:Key="DialMarkBrush" Color="#BCA06D" />
  <SolidColorBrush x:Key="DialShadowBrush" Color="#020302" />
  <SolidColorBrush x:Key="DialOuterBrush" Color="#12130F" />
  <SolidColorBrush x:Key="DialRimBrush" Color="#68583E" />
  <SolidColorBrush x:Key="DialTickBedBrush" Color="#080906" />
  <SolidColorBrush x:Key="DialInsetBrush" Color="#151610" />
  <SolidColorBrush x:Key="DialPlateBrush" Color="#10110D" />
  <SolidColorBrush x:Key="DialRecessBrush" Color="#080906" />
  <SolidColorBrush x:Key="DialCenterBrush" Color="#0A0B08" />
  <SolidColorBrush x:Key="DialTickBrush" Color="#A88D5C" />
  <SolidColorBrush x:Key="DialLogoBrush" Color="#D9BC7D" />
  <SolidColorBrush x:Key="DialMetalDark" Color="#050604" />
  <SolidColorBrush x:Key="DialMetalMid" Color="#29261D" />
  <SolidColorBrush x:Key="DialMetalLight" Color="#6E6047" />
  <SolidColorBrush x:Key="DialStatusBrush" Color="#4BA8DE" />
  <SolidColorBrush x:Key="DialPositiveBrush" Color="#63B97B" />
  <SolidColorBrush x:Key="DialWarningBrush" Color="#D69D51" />
  <SolidColorBrush x:Key="DialSwitchingBrush" Color="#9A6AD1" />
  <SolidColorBrush x:Key="DialIdleBrush" Color="#777268" />
  <SolidColorBrush x:Key="DialErrorBrush" Color="#D9685C" />
  <SolidColorBrush x:Key="DialPressedOverlay" Color="#36000000" />
  <RadialGradientBrush x:Key="DialVignetteBrush" Center="0.34,0.26" GradientOrigin="0.28,0.2" RadiusX="0.86" RadiusY="0.86">
    <GradientStop Color="#00000000" Offset="0" />
    <GradientStop Color="#16000000" Offset="0.62" />
    <GradientStop Color="#42000000" Offset="1" />
  </RadialGradientBrush>
  <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#09121C" />
</ResourceDictionary>

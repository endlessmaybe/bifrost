{
  "$id": "bifrost.build-inputs.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "inputs", "toolchain"],
  "properties": {
    "format": {"const": "BIFROST-BUILD-INPUTS-1"},
    "toolchain": {
      "type": "object", "additionalProperties": false, "required": ["required"],
      "properties": {"required": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "object", "additionalProperties": false, "required": ["name", "version", "download_url", "sha256"], "properties": {"name": {"type": "string", "minLength": 1, "maxLength": 128}, "version": {"type": "string", "minLength": 1, "maxLength": 128}, "download_url": {"type": "string", "pattern": "^https://"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}}}
    },
    "inputs": {
      "type": "array", "minItems": 1, "maxItems": 20000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "bytes", "sha256", "mode", "kind"],
        "properties": {
          "path": {"type": "string", "minLength": 1, "maxLength": 240, "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(^|/)(\\.|\\.\\.|CON|PRN|AUX|NUL)(/|$)).+$"},
          "bytes": {"type": "integer", "minimum": 1, "maximum": 67108864},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "mode": {"type": "string", "pattern": "^[0-7]{3,4}$"},
          "kind": {"type": "string", "enum": ["source", "lock", "verification", "wrapper", "patch", "overlay", "script", "metadata", "toolchain", "core", "license"]}
        }
      }
    }
  }
}

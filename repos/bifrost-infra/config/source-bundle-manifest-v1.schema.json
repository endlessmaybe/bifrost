{
  "$id": "bifrost.source-bundle-manifest.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "test_only", "signature_status", "release_sequence", "build_plan_sha256", "binary_artifacts", "binary_artifacts_sha256", "policy_sha256", "source_policy_sha256", "core_provenance_sha256", "build_inputs_sha256", "toolchain_sha256", "scope", "git", "entries", "toolchain", "core_provenance", "build_inputs", "dependency_license_manifest", "limits", "archive_policy", "source_bundle_id"],
  "properties": {
    "format": {"const": "BIFROST-SOURCE-BUNDLE-1"},
    "test_only": {"type": "boolean"},
    "signature_status": {"type": "string", "enum": ["TEST-ONLY-UNSIGNED", "DRAFT-NOT-RELEASABLE", "SIGNED-EXTERNAL-CEREMONY"]},
    "release_sequence": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "build_plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "binary_artifacts_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "policy_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "source_policy_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "core_provenance_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "build_inputs_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "toolchain_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "source_bundle_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,160}$"},
    "binary_artifacts": {"type": "array", "minItems": 0, "maxItems": 256, "items": {"$ref": "#/$defs/artifact"}},
    "scope": {"type": "object", "additionalProperties": false, "required": ["included", "excluded"], "properties": {"included": {"type": "array", "items": {"type": "string"}}, "excluded": {"type": "array", "items": {"type": "string"}}}},
    "git": {"type": "object"},
    "entries": {"type": "array", "minItems": 1, "maxItems": 20000, "items": {"$ref": "#/$defs/entry"}},
    "toolchain": {"type": "object"},
    "core_provenance": {"type": "object"},
    "build_inputs": {"type": "object"},
    "dependency_license_manifest": {"type": "object"},
    "limits": {"type": "object"},
    "archive_policy": {"type": "object", "additionalProperties": false, "required": ["format", "entry_order", "timestamp", "mode_source"], "properties": {"format": {"const": "ustar"}, "entry_order": {"const": "lexicographic-bytewise"}, "timestamp": {"const": 0}, "mode_source": {"const": "manifest"}}}
  },
  "$defs": {
    "entry": {"type": "object", "additionalProperties": false, "required": ["path", "bytes", "sha256", "mode"], "properties": {"path": {"type": "string", "minLength": 1, "maxLength": 240}, "bytes": {"type": "integer", "minimum": 0, "maximum": 67108864}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "mode": {"type": "string", "pattern": "^[0-7]{3}$"}}},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["id", "path", "install_path", "platform", "arch", "kind", "bytes", "sha256"], "properties": {"id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,160}$"}, "path": {"type": "string", "minLength": 1, "maxLength": 240}, "install_path": {"type": "string", "minLength": 1, "maxLength": 240}, "platform": {"type": "string", "enum": ["android", "windows", "linux"]}, "arch": {"type": "string", "minLength": 1, "maxLength": 64}, "kind": {"type": "string", "minLength": 1, "maxLength": 64}, "bytes": {"type": "integer", "minimum": 1, "maximum": 536870912}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}
  }
}
